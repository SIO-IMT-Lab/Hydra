[Unit]
Description=Hydra Starlink power-on
After=network.target
# After=rabbitmq-server.service

[Service]
Type=oneshot
User=imt
WorkingDirectory=/home/imt/Hydra/sensor-modules/controller
ExecStart=/home/imt/Hydra/sensor-modules/.venv/bin/python -m launch.starlink_launch --state enable
TimeoutStartSec=300

# No [Install]: this is launched by hydra-starlink-on.timer, not enabled directly.
